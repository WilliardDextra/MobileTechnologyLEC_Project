<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_obsidian"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Top Tactical Info Banner -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSosInfoBanner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/accent_red_surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/accent_red"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_beacon"
                    app:tint="@color/accent_red" />

                <TextView
                    style="@style/TacticalTelemetryRed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:text="FLARE MODE MEMANCARKAN LOKASI GPS ANDA KE REGU SAR SEKITAR VIA BLUETOOTH LOW ENERGY TANPA JARINGAN SELULER."
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Center Flare Interactive Button Section -->
        <FrameLayout
            android:id="@+id/layoutFlareButtonContainer"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="28dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardSosInfoBanner">

            <!-- Circular Progress Ring (Hold Indicator) -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressFlareHold"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                app:indicatorColor="@color/accent_red"
                app:indicatorSize="200dp"
                app:trackColor="@color/surface_elevated"
                app:trackCornerRadius="6dp"
                app:trackThickness="8dp" />

            <!-- Large Circular Crimson Button -->
            <FrameLayout
                android:id="@+id/btnFlareTrigger"
                android:layout_width="168dp"
                android:layout_height="168dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_radar_center"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/ivFlareIcon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_beacon"
                        app:tint="@color/accent_red" />

                    <TextView
                        android:id="@+id/tvFlareBtnText"
                        style="@style/TacticalHeadline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="AKTIFKAN FLARE"
                        android:textColor="@color/accent_red"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvFlareBtnSubtext"
                        style="@style/TacticalTelemetry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="TAHAN 1.5 DETIK"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <!-- Flare Status Pill -->
        <TextView
            android:id="@+id/pillFlareStatus"
            style="@style/TacticalTelemetryAmber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_pill_badge_amber"
            android:text="• MODE SIAGA // SIAP DILUNCURKAN"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutFlareButtonContainer" />

        <!-- 2 Status Cards -->
        <LinearLayout
            android:id="@+id/layoutStatusCards"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pillFlareStatus">

            <!-- Card 1: Communication -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tactical_card_elevated"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_mesh"
                    app:tint="@color/accent_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TacticalSubhead"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Komunikasi BLE Beacon"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvBleStatusDesc"
                        style="@style/TacticalTelemetry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TX Interval: Standby (1s saat flare aktif)"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBleBadge"
                    style="@style/TacticalTelemetryBlue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_badge_blue"
                    android:text="SIAP"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Card 2: Power Management -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_tactical_card_elevated"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_battery"
                    app:tint="@color/accent_green" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TacticalSubhead"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manajemen Daya Taktis"
                        android:textSize="13sp" />

                    <TextView
                        style="@style/TacticalTelemetry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tingkat Hemat: 85% • Estimasi 32 Jam"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    style="@style/TacticalTelemetryGreen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_badge_green"
                    android:text="OPTIMAL"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3 Quick Action Tiles -->
        <TextView
            android:id="@+id/lblQuickActions"
            style="@style/TacticalTelemetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="AKSI CEPAT DARURAT:"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutStatusCards" />

        <LinearLayout
            android:id="@+id/layoutQuickTiles"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblQuickActions">

            <!-- Tile 1: SOS Call -->
            <LinearLayout
                android:id="@+id/tileSosCall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tactical_card_elevated"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_call"
                    app:tint="@color/accent_red" />

                <TextView
                    style="@style/TacticalTelemetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="SOS CALL"
                    android:textColor="@color/accent_red"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Tile 2: SMS Alert -->
            <LinearLayout
                android:id="@+id/tileSmsAlert"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tactical_card_elevated"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_sms"
                    app:tint="@color/accent_amber" />

                <TextView
                    style="@style/TacticalTelemetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="SMS ALERT"
                    android:textColor="@color/accent_amber"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Tile 3: Responders -->
            <LinearLayout
                android:id="@+id/tileResponders"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tactical_card_elevated"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/accent_green" />

                <TextView
                    style="@style/TacticalTelemetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="RESPONDERS"
                    android:textColor="@color/accent_green"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
