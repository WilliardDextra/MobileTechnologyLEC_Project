<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_obsidian"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Top Header Navigation -->
        <LinearLayout
            android:id="@+id/layoutMeshTop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                style="@style/TacticalHeadline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="JARINGAN MESH"
                android:textSize="20sp" />

            <TextView
                style="@style/TacticalTelemetryGreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_badge_green"
                android:text="• 5 NODE TERHUBUNG"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Topology Card Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTopologyGraph"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutMeshTop"
            app:strokeColor="@color/border_subtle"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Header in Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TacticalTelemetryGreen"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="TOPOLOGI VISUAL AKTIF" />

                    <TextView
                        style="@style/TacticalTelemetryGreen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_badge_green"
                        android:text="Rute Optimal (4 Hop)"
                        android:textSize="9sp" />
                </LinearLayout>

                <!-- Custom Canvas Mesh Topology Graph -->
                <com.offroute.app.ui.custom.MeshTopologyView
                    android:id="@+id/meshTopologyView"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginTop="8dp" />

                <!-- Footer Summary -->
                <TextView
                    android:id="@+id/tvMeshFooterSummary"
                    style="@style/TacticalTelemetry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Anda -&gt; Bravo -&gt; Med -&gt; Base | Sinyal 94%"
                    android:textColor="@color/accent_green"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3 Telemetry Metric Cards -->
        <LinearLayout
            android:id="@+id/layoutMeshTelemetryCards"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardTopologyGraph">

            <!-- Card 1: Integritas -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tactical_card_elevated"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    style="@style/TacticalTelemetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INTEGRITAS"
                    android:textSize="9sp" />

                <TextView
                    style="@style/TacticalHeadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="99.4%"
                    android:textColor="@color/accent_green"
                    android:textSize="15sp" />

                <TextView
                    style="@style/TacticalTelemetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+0.2% optimal"
                    android:textSize="8sp" />
            </LinearLayout>

            <!-- Card 2: Kecepatan -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tactical_card_elevated"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    style="@style/TacticalTelemetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KECEPATAN"
                    android:textSize="9sp" />

                <TextView
                    style="@style/TacticalHeadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="2.4 p/s"
                    android:textSize="15sp" />

                <TextView
                    style="@style/TacticalTelemetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+0.4 p/s laju"
                    android:textSize="8sp" />
            </LinearLayout>

            <!-- Card 3: Latensi -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tactical_card_elevated"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    style="@style/TacticalTelemetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LATENSI"
                    android:textSize="9sp" />

                <TextView
                    style="@style/TacticalHeadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="36 ms"
                    android:textColor="@color/accent_amber"
                    android:textSize="15sp" />

                <TextView
                    style="@style/TacticalTelemetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-4 ms stabil"
                    android:textSize="8sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section: AKTIVITAS TERKINI (LIVE PING) -->
        <TextView
            android:id="@+id/lblMeshActivity"
            style="@style/TacticalTelemetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="AKTIVITAS TERKINI (LIVE PING):"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutMeshTelemetryCards" />

        <LinearLayout
            android:id="@+id/layoutMeshLogsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblMeshActivity" />

        <!-- Green CTA: Broadcast Darurat -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBroadcastEmergency"
            style="@style/TacticalPrimaryButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:drawableStart="@drawable/ic_beacon"
            android:drawableTint="@color/bg_obsidian"
            android:paddingHorizontal="16dp"
            android:text="BROADCAST DARURAT (SOS BEACON)"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutMeshLogsContainer" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
