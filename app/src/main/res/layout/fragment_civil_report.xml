<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_obsidian"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:id="@+id/tvReportHeaderTag"
            style="@style/TacticalTelemetryRed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_badge_red"
            android:text="• LAPOR BAHAYA // MESH BROADCAST"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvReportTitle"
            style="@style/TacticalHeadline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Laporkan Titik Bahaya"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvReportHeaderTag" />

        <TextView
            android:id="@+id/tvReportDesc"
            style="@style/TacticalBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Peringatan Anda akan langsung disiarkan ke pengguna sekitar dan tim SAR melalui jaringan mesh."
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvReportTitle" />

        <!-- 1. Select Incident Type -->
        <TextView
            android:id="@+id/lblIncidentType"
            style="@style/TacticalTelemetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="PILIH JENIS BAHAYA (PILIH SALAH SATU):"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvReportDesc" />

        <LinearLayout
            android:id="@+id/layoutIncidentTypes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblIncidentType">

            <!-- Type 1: Fire -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTypeFire"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/accent_red_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/accent_red"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_hazard_fire"
                        app:tint="@color/accent_red" />

                    <TextView
                        style="@style/TacticalSubhead"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Kebakaran"
                        android:textColor="@color/accent_red"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Type 2: Flood -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTypeFlood"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_subtle"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_hazard_flood"
                        app:tint="@color/text_muted" />

                    <TextView
                        style="@style/TacticalSubhead"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Banjir"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Type 3: Blockage -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTypeBlockage"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_subtle"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_hazard_blockage"
                        app:tint="@color/text_muted" />

                    <TextView
                        style="@style/TacticalSubhead"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Rintangan"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- 2. Current Location & Mini Map -->
        <TextView
            android:id="@+id/lblReportLocation"
            style="@style/TacticalTelemetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="LOKASI KEJADIAN (GPS AKTIF):"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutIncidentTypes" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMiniMapContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblReportLocation"
            app:strokeColor="@color/border_subtle"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Mini OSMdroid Map -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="140dp">

                    <org.osmdroid.views.MapView
                        android:id="@+id/miniMapView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Center Fixed Pin Overlay -->
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_marker_hazard"
                        app:tint="@color/accent_red" />

                    <!-- Top Pill on Mini Map -->
                    <TextView
                        style="@style/TacticalTelemetryGreen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_pill_badge_green"
                        android:text="• LIVE GPS ACTIVE"
                        android:textSize="9sp" />
                </FrameLayout>

                <!-- Location Address Text -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_gps"
                        app:tint="@color/accent_blue" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvReportAddress"
                            style="@style/TacticalSubhead"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Jl. Merdeka Barat No. 12, Sektor 04"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvReportCoordinates"
                            style="@style/TacticalTelemetry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-6.2088° S, 106.8456° E [AKURASI 3M]"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Additional Information -->
        <TextView
            android:id="@+id/lblAdditionalInfo"
            style="@style/TacticalTelemetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="INFORMASI TAMBAHAN (OPSIONAL):"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardMiniMapContainer" />

        <!-- Photo Simulation Row -->
        <LinearLayout
            android:id="@+id/layoutPhotoSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblAdditionalInfo">

            <!-- Capture Photo Card -->
            <LinearLayout
                android:id="@+id/btnCapturePhoto"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tactical_card_elevated"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/accent_green" />

                <TextView
                    style="@style/TacticalTelemetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="AMBIL FOTO BUKTI"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Sample Photo Preview Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPhotoPreview"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface_elevated"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/accent_green"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ivPhotoPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_hazard_fire"
                        app:tint="@color/accent_red" />

                    <TextView
                        android:id="@+id/btnRemovePhoto"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_btn_danger"
                        android:gravity="center"
                        android:text="×"
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Description Input -->
        <EditText
            android:id="@+id/etSituationDesc"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input_box"
            android:fontFamily="sans-serif"
            android:gravity="top|start"
            android:hint="Jelaskan situasi bahaya secara singkat (misal: kobaran api menutup akses jalan utama)..."
            android:inputType="textMultiLine"
            android:lineSpacingExtra="3dp"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutPhotoSection" />

        <!-- Red CTA: Report Hazard -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSubmitReport"
            style="@style/TacticalDangerButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:drawableStart="@drawable/ic_report"
            android:drawableTint="@color/text_primary"
            android:paddingHorizontal="16dp"
            android:text="SIARKAN LAPORAN BAHAYA -&gt;"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etSituationDesc" />

        <TextView
            style="@style/TacticalTelemetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:text="BROADCAST AKAN DISINKRONISASI VIA BLE MESH &amp; P2P"
            android:textSize="9sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnSubmitReport" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
