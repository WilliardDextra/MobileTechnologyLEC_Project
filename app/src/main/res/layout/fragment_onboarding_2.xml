<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Visual 3-Node Topology Diagram Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVisualMesh"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/border_subtle"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="14dp">

                <TextView
                    style="@style/TacticalTelemetryGreen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOPOLOGI MESH // BLE-DIRECT"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Nodes Diagram -->
                <LinearLayout
                    android:id="@+id/layoutNodes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toTopOf="@id/tvTelemetryMesh"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <!-- Node 1 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_tactical_card_elevated"
                            android:padding="6dp"
                            android:src="@drawable/ic_person"
                            app:tint="@color/accent_green" />

                        <TextView
                            style="@style/TacticalTelemetry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="[UNIT A]"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp" />

                        <TextView
                            style="@style/TacticalTelemetryGreen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CH//01"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <TextView
                        style="@style/TacticalTelemetryGreen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="6dp"
                        android:text="◄•8ms•►"
                        android:textSize="9sp" />

                    <!-- Node 2 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_tactical_card_elevated"
                            android:padding="6dp"
                            android:src="@drawable/ic_mesh"
                            app:tint="@color/accent_amber" />

                        <TextView
                            style="@style/TacticalTelemetry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="[UNIT B]"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp" />

                        <TextView
                            style="@style/TacticalTelemetryAmber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+1.2KM HOP"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <TextView
                        style="@style/TacticalTelemetryGreen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="6dp"
                        android:text="◄•14ms•►"
                        android:textSize="9sp" />

                    <!-- Node 3 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_tactical_card_elevated"
                            android:padding="6dp"
                            android:src="@drawable/ic_beacon"
                            app:tint="@color/accent_blue" />

                        <TextView
                            style="@style/TacticalTelemetry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="[POSKO]"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp" />

                        <TextView
                            style="@style/TacticalTelemetryBlue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GATEWAY"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTelemetryMesh"
                    style="@style/TacticalTelemetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SIGNAL: OFF-GRID LOCAL | LATENCY: 14MS"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tag Badge -->
        <TextView
            android:id="@+id/badgeMesh"
            style="@style/TacticalTelemetryGreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_pill_badge_green"
            android:text="[ PEER-TO-PEER MESH ] RF//BLE-DIRECT"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardVisualMesh" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitleMesh"
            style="@style/TacticalHeadline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Komunikasi Tanpa Menara BTS"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/badgeMesh" />

        <TextView
            android:id="@+id/tvDescriptionMesh"
            style="@style/TacticalBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Setiap perangkat bertindak sebagai penyambung (relay) data otomatis, menghubungkan lokasi terisolir ke posko darurat."
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitleMesh" />

        <!-- 2 Feature Cards -->
        <LinearLayout
            android:id="@+id/cardMeshRelay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tactical_card_elevated"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDescriptionMesh">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_mesh"
                app:tint="@color/accent_green" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TacticalSubhead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Multi-Hop Relay Otomatis"
                    android:textSize="14sp" />

                <TextView
                    style="@style/TacticalTelemetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estafet paket data menembus halangan medan" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardMeshSecurity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_tactical_card_elevated"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardMeshRelay">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_shield"
                app:tint="@color/accent_blue" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TacticalSubhead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enkripsi P2P Lapangan"
                    android:textSize="14sp" />

                <TextView
                    style="@style/TacticalTelemetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Privasi koordinat aman antar simpul ad-hoc" />
            </LinearLayout>
        </LinearLayout>

        <!-- Status Bar -->
        <TextView
            android:id="@+id/tvTopologyStatus"
            style="@style/TacticalTelemetryGreen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pill_badge_green"
            android:gravity="center"
            android:padding="8dp"
            android:text="TOPOLOGI SIAP: 3 SIMPUL TERDETEKSI | 100% AIR-GAP"
            android:textSize="10sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardMeshSecurity" />

        <!-- Navigation Buttons: Back & Next -->
        <LinearLayout
            android:id="@+id/layoutNav2"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTopologyStatus">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBack2"
                style="@style/TacticalSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="&lt; KEMBALI" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNext2"
                style="@style/TacticalPrimaryButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="LANJUT &gt;" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
