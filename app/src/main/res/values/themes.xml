<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.OffRoute" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorPrimaryContainer">@color/accent_green_dark</item>
        <item name="colorOnPrimary">@color/bg_obsidian</item>

        <item name="colorSecondary">@color/surface_elevated</item>
        <item name="colorSecondaryContainer">@color/surface_card</item>
        <item name="colorOnSecondary">@color/text_primary</item>

        <item name="colorError">@color/accent_red</item>
        <item name="colorErrorContainer">@color/accent_red_surface</item>
        <item name="colorOnError">@color/text_primary</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/bg_obsidian</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorSurfaceContainer">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status & Navigation Bars -->
        <item name="android:statusBarColor">@color/bg_obsidian</item>
        <item name="android:navigationBarColor">@color/surface_nav</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Default text appearance -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Legacy / Alias support -->
    <style name="Theme.MyApplication" parent="Theme.OffRoute" />
</resources>
